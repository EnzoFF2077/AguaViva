rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsReport() {
      return signedIn() && resource.data.ownerId == request.auth.uid;
    }

    function ownsProfile(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if ownsProfile(userId);

      allow create: if ownsProfile(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email is string
        && request.resource.data.displayName is string;

      allow update: if ownsProfile(userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'uid',
          'email',
          'displayName',
          'isAnonymous',
          'createdAt',
          'lastLoginAt'
        ]);

      allow delete: if false;
    }

    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.caseStatus in ['waitingInternet', 'pendingPhoto']
        && request.resource.data.photo.status == 'pending'
        && request.resource.data.location.confirmed == true;

      allow read: if ownsReport();

      allow update: if ownsReport()
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.caseStatus in [
          'waitingInternet',
          'pendingPhoto',
          'submitted'
        ]
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'photo',
          'caseStatus',
          'submittedAt',
          'updatedAt',
          'updatedAtClient'
        ]);

      allow delete: if false;
    }
  }
}
